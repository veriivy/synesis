# Copy to web/.env.local. Next reads it automatically; it is gitignored.
#
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Rename this and the
# value silently becomes undefined at runtime rather than failing loudly.
#
# The default in src/lib/api.ts is http://localhost:8000, so for local dev you
# can skip this file entirely. Set it for a deployed frontend.
NEXT_PUBLIC_API_BASE=http://localhost:8000
