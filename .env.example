# Copy to .env and fill in. .env is gitignored. Never commit a real key.

IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
# Confirm this id with GET $IFM_BASE_URL/models — a plausible name is not enough.
IFM_MODEL=IFM/K2-Horizon-375B-A23B

# Frontend origin. The browser calls this server directly (no Next rewrite).
CORS_ORIGINS=http://localhost:3000

# K2 analysis rounds after the opening PoAs. Advocates currently use the same
# IFM chat() as K2 (Claude/GPT keys come later).
MAX_ROUNDS=3
