# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- providers ---------------------------------------------------------------
# You only need keys for the providers you actually enable (see ENABLED_AGENTS).
# Each key present unlocks one negotiating agent + one sponsor prize.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
IFM_API_KEY=
XAI_API_KEY=

# --- model ids ---------------------------------------------------------------
# CONFIRM THESE AT RUNTIME. `python -m engine.cli models` lists what each key can
# actually reach. Do not assume an id is valid because it looks right.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-2.5-pro
IFM_MODEL=moonshotai/Kimi-K2-Instruct
XAI_MODEL=grok-4

# --- negotiation -------------------------------------------------------------
# Comma-separated provider keys. Order matters only for display.
# Cut to two (anthropic,openai) the moment the demo gets tight.
ENABLED_AGENTS=anthropic,openai
MODERATOR_PROVIDER=anthropic
MAX_ROUNDS=3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed to hit the API. Add the Vercel URL after deploy.
CORS_ORIGINS=http://localhost:5173

# Root for per-room clones of the demo target repo. Gitignored.
WORKSPACE_ROOT=./workspaces

# The demo target repo (Repo 2) the agents clone and write into.
TARGET_REPO_URL=
TARGET_REPO_REF=main

# --- persistence -------------------------------------------------------------
# Optional. If unset, the server keeps everything in memory and still runs the
# full demo. Never let Mongo being down kill the demo.
MONGODB_URI=
MONGODB_DB=synesis

# --- web (Vite needs the VITE_ prefix; put this one in web/.env.local) --------
# VITE_API_BASE=http://localhost:8000
