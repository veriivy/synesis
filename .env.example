# Copy to .env and fill in. .env is gitignored. Never commit a real key.
#
# A prior version of this file had a real-looking IFM_API_KEY committed in
# plaintext — placeholder-shaped values only from here on. If that key was
# ever live, rotate it; it's in git history regardless of this edit.

IFM_API_KEY=IFM-v1_replace-with-your-own-key
IFM_BASE_URL=https://api.ifm.ai/v1
# Confirm this id with GET $IFM_BASE_URL/models — a plausible name is not enough.
IFM_MODEL=IFM/K2-Horizon-375B-A23B

# Without IFM_API_KEY set, the orchestrator (orchestrator/app/config.py)
# falls back to a deterministic template provider for K2's own calls —
# no key is required to run the loop end-to-end, just to make it a real
# model. Per-user agent providers (Claude/Gemini/GPT) aren't implemented
# yet regardless of what's set here — see orchestrator/README.md.
