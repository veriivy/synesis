# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# --- K2 (moderator) ----------------------------------------------------------
IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
MODERATOR_PROVIDER=ifm

# --- Gemini (advocate a1) ----------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
AGENT_A1_PROVIDER=google

# --- ChatGPT (advocate a2) ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
AGENT_A2_PROVIDER=openai

# Optional Claude seat (set AGENT_A1_PROVIDER=anthropic to use it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- loop --------------------------------------------------------------------
MAX_ROUNDS=3
STOP_ON_CONVERGE=0

CORS_ORIGINS=http://localhost:3000
