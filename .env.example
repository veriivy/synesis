# Copy to .env and fill in. .env is gitignored. Never commit a real key.
#
# A prior version of this file had a real-looking IFM_API_KEY committed in
# plaintext — placeholder-shaped values only from here on. If that key was
# ever live, rotate it; it's in git history regardless of this edit.

# --- K2 (moderator) ----------------------------------------------------------
IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
MODERATOR_PROVIDER=ifm

# --- Gemini (advocate a1) ----------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
AGENT_A1_PROVIDER=google

# --- ChatGPT (advocate a2) ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
AGENT_A2_PROVIDER=openai

# Optional Claude seat (set AGENT_A1_PROVIDER=anthropic to use it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- loop --------------------------------------------------------------------
MAX_ROUNDS=3
STOP_ON_CONVERGE=0

# --- execution (orchestrator/coding.py) ---------------------------------------
# "agent" (default): each ticket's files are written by a real model call, on
# the provider of whichever participant owns that agent. "placeholder": skip
# the coding call and write TODO stubs — the pre-coding-agent behaviour, kept
# for a rehearsal where execution latency matters more than content, or a demo
# with no keys at all.
EXECUTION_MODE=agent
# Output ceiling per ticket. A whole file has to fit, so this is larger than
# the negotiation calls' 4096.
CODING_MAX_TOKENS=8192
# How much of the repo a coder is shown. Files its ticket owns are always
# included in full; the rest fill what's left of this budget.
CODING_CONTEXT_CHARS=24000

CORS_ORIGINS=http://localhost:3000

# --- persistence (orchestrator/db.py) -----------------------------------------
# Optional. Unset means every room stays in-memory only, same as before —
# nothing here is required to run the orchestrator. Get an Atlas connection
# string (mongodb+srv://...) from the MongoDB Atlas dashboard; the database
# itself doesn't need to exist ahead of time, Mongo creates it on first write.
MONGODB_URI=
MONGODB_DB_NAME=synesis
