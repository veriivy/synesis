# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# --- K2 (moderator) ----------------------------------------------------------
IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
# Confirm this id with GET $IFM_BASE_URL/models — a plausible name is not enough.
IFM_MODEL=IFM/K2-Horizon-375B-A23B
MODERATOR_PROVIDER=ifm

# --- Claude (advocate a1) ----------------------------------------------------
ANTHROPIC_API_KEY=
# Confirm at runtime. Wrong id fails at call time, not at import.
ANTHROPIC_MODEL=claude-sonnet-4-5
AGENT_A1_PROVIDER=anthropic

# --- GPT (advocate a2) -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Leave empty unless you use a proxy.
OPENAI_BASE_URL=
AGENT_A2_PROVIDER=openai

# --- loop --------------------------------------------------------------------
# How many K2 analysis passes to run. Change this; do not hardcode in Python.
MAX_ROUNDS=3
# 0 = always run all MAX_ROUNDS. 1 = stop early if K2 reports no blocking diffs.
STOP_ON_CONVERGE=0

# Frontend origin. The browser calls this server directly (no Next rewrite).
CORS_ORIGINS=http://localhost:3000
