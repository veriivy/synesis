# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- providers ---------------------------------------------------------------
# You only need keys for the providers you actually enable (see ENABLED_AGENTS)
# plus the one running the moderator. Each key present unlocks one more role and
# one more sponsor prize.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
IFM_API_KEY=
XAI_API_KEY=

# --- model ids ---------------------------------------------------------------
# CONFIRM THESE AT RUNTIME. `python -m engine.cli doctor` lists what each key can
# actually reach. Do not assume an id is valid because it looks right.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-2.5-pro
IFM_MODEL=moonshotai/Kimi-K2-Instruct
XAI_MODEL=grok-4

# --- negotiation -------------------------------------------------------------
# Comma-separated provider keys — the agents that argue.
# Cut to two (anthropic,openai) the moment the demo gets tight.
ENABLED_AGENTS=anthropic,openai

# The moderator judges each round and writes the workplan. It is deliberately a
# provider that is NOT arguing: if Claude both advocates for u1 and referees the
# argument, that is a conflict of interest a judge can point at. K2 referees.
# Requires IFM_API_KEY. K2 does not need to be in ENABLED_AGENTS for this.
MODERATOR_PROVIDER=ifm

MAX_ROUNDS=3
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed to hit the API. The frontend calls this server
# directly (no proxy), so its origin MUST be here. Add the Vercel URL after deploy.
CORS_ORIGINS=http://localhost:3000

# Root for per-room clones of the demo target repo. Gitignored.
WORKSPACE_ROOT=./workspaces

# The demo target repo (Repo 2) the agents clone and write into.
TARGET_REPO_URL=
TARGET_REPO_REF=main

# --- persistence -------------------------------------------------------------
# Optional. If unset, the server keeps everything in memory and still runs the
# full demo. Never let Mongo being down kill the demo.
MONGODB_URI=
MONGODB_DB=synesis

# --- web ---------------------------------------------------------------------
# Next only exposes variables prefixed NEXT_PUBLIC_ to the browser. Put this one
# in web/.env.local for dev, and in Vercel's environment settings for production.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
